			count: 2
			path: Classes/EventListener/AfterLinkIsGeneratedEventListener.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(int\|string\)\: bool\)\|null, Closure\(string\)\: bool given\.$#'
			identifier: argument.type
			count: 2
			path: Classes/EventListener/AfterUriIsProcessedEventListener.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
